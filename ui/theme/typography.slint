// AXIOM v2 — compact desktop-tool typography. Mono for technical values.

export global Type {
    out property <length> major: 18px;
    out property <length> title: 14px;
    out property <length> ui: 12px;
    out property <length> ctl: 12px;
    out property <length> meta: 11px;
    out property <length> micro: 10px;
    out property <string> mono: "monospace";
}
