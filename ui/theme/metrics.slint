// AXIOM v2 — tight editor spacing. Most UI lives between 4–12px.

export global Metrics {
    out property <length> activity: 48px;
    out property <length> titlebar: 34px;
    out property <length> statusbar: 24px;
    out property <length> dock: 204px;
    out property <length> inspector: 264px;
    out property <length> ctl-h: 26px;
    out property <length> rail-item: 40px;
    out property <length> r-sm: 3px;
    out property <length> r-md: 4px;
}
