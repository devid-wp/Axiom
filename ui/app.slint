import { HorizontalBox, VerticalBox, GridBox } from "std-widgets.slint";

struct StudioElement {
    id: string,
    kind: string, // wall, room, column, beam
    x: length,
    y: length,
    w: length,
    h: length,
    material: string,
    selected: bool,
}

export global AppState {
    in-out property <string> view: "home"; // home, study, explore, studio
    in-out property <string> lang: "en";
    in-out property <string> studio-tool: "select"; // select, wall, room, column, beam
    in-out property <string> studio-selected: "";
    in-out property <string> project-name: "Pavilion 01";
    in-out property <length> canvas-w: 900px;
    in-out property <length> canvas-h: 600px;
    in-out property <[StudioElement]> elements;
    callback request-new-element(string, length, length);
    callback request-select(string);
    callback request-move(string, length, length);
    callback request-resize(string, length, length);
    callback request-material(string, string);
    callback request-delete(string);
    callback request-duplicate(string);
    callback request-update-pos(string, length, length);
    callback request-canvas-click(length, length);
    callback request-save();
    callback request-new-project();
}

// Colors — premium black+purple
export global Theme {
    out property <color> bg: #07070A;
    out property <color> surface: #12131A;
    out property <color> surface2: #1A1B23;
    out property <color> surface3: #23242F;
    out property <color> border: #1E1E2A;
    out property <color> border2: #2A2A3A;
    out property <color> text: #F1F0F5;
    out property <color> muted: #9A9AB0;
    out property <color> muted2: #6E6E85;
    out property <color> purple: #7C5CFC;
    out property <color> purple2: #9D7CFF;
    out property <color> purple-glow: #7C5CFC28;
}

component Titlebar inherits Rectangle {
    height: 38px;
    background: #0C0C11;
    border-color: Theme.border;
    border-width: 0; // bottom only
    HorizontalBox {
        padding: 0;
        padding-left: 14px;
        padding-right: 14px;
        alignment: space-between;
        HorizontalBox {
            spacing: 10px;
            alignment: start;
            Rectangle { width: 12px; height: 12px; border-radius: 6px; background: #FF5F56; border-width: 1px; border-color: #00000014; }
            Rectangle { width: 12px; height: 12px; border-radius: 6px; background: #FFBD2E; border-width: 1px; border-color: #00000014; }
            Rectangle { width: 12px; height: 12px; border-radius: 6px; background: #27C93F; border-width: 1px; border-color: #00000014; }
            Rectangle { width: 22px; height: 22px; border-radius: 6px; background: Theme.purple; }
            Text { text: "AXIOM"; font-size: 12px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
            Text { text: "— Architecture Learning OS"; font-size: 10px; color: Theme.muted; vertical-alignment: center; }
        }
        HorizontalBox {
            spacing: 8px;
            alignment: end;
            Rectangle { width: 6px; height: 6px; border-radius: 3px; background: #27C93F; }
            Text { text: "Local • Offline Ready"; font-size: 11px; color: Theme.muted; vertical-alignment: center; }
            Text { text: "|"; font-size: 11px; color: #ffffff30; vertical-alignment: center; }
            Text { text: AppState.lang == "en" ? "EN" : "RU"; font-size: 11px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
}

component Sidebar inherits Rectangle {
    width: 88px;
    background: #12131AEE;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 0;
    VerticalBox {
        padding: 14px;
        spacing: 8px;
        alignment: start;
        Rectangle {
            width: 44px; height: 44px; border-radius: 12px; background: Theme.purple; drop-shadow-blur: 18px; drop-shadow-color: Theme.purple-glow;
            Text { text: "A"; font-size: 17px; font-weight: 700; color: white; horizontal-alignment: center; vertical-alignment: center; }
        }
        Rectangle { height: 8px; }
        VerticalBox {
            spacing: 8px;
            TouchArea { clicked => { AppState.view = "home"; }
                Rectangle {
                    height: 56px; border-radius: 14px;
                    background: AppState.view == "home" ? #7C5CFC28 : transparent;
                    border-width: 1px; border-color: AppState.view == "home" ? #7C5CFC60 : transparent;
                    Text { text: "⌖\nHome"; font-size: 10px; font-weight: 700; color: AppState.view == "home" ? #ECE9FF : Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                    animate background { duration: 220ms; easing: ease-in-out; }
                }
            }
            TouchArea { clicked => { AppState.view = "study"; }
                Rectangle {
                    height: 56px; border-radius: 14px;
                    background: AppState.view == "study" ? Theme.purple : transparent;
                    border-width: 1px; border-color: AppState.view == "study" ? transparent : transparent;
                    Text { text: "◐\nStudy"; font-size: 10px; font-weight: 700; color: AppState.view == "study" ? white : Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            TouchArea { clicked => { AppState.view = "studio"; }
                Rectangle {
                    height: 58px; border-radius: 14px;
                    background: AppState.view == "studio" ? Theme.purple : #00000000;
                    drop-shadow-blur: AppState.view == "studio" ? 20px : 0px; drop-shadow-color: Theme.purple-glow;
                    border-width: 1px; border-color: AppState.view == "studio" ? transparent : Theme.border;
                    Text { text: "⬢\nStudio"; font-size: 10px; font-weight: 700; color: AppState.view == "studio" ? white : Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                    animate background { duration: 220ms; }
                }
            }
            TouchArea { clicked => { AppState.view = "explore"; }
                Rectangle {
                    height: 56px; border-radius: 14px;
                    background: AppState.view == "explore" ? #7C5CFC28 : transparent;
                    border-width: 1px; border-color: AppState.view == "explore" ? #7C5CFC60 : transparent;
                    Text { text: "⬣\nExplore"; font-size: 10px; font-weight: 700; color: AppState.view == "explore" ? #ECE9FF : Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
        Rectangle { height: 12px; }
        VerticalBox {
            spacing: 6px;
            Text { text: "Language"; font-size: 8px; color: Theme.muted; horizontal-alignment: center; letter-spacing: 1px; }
            TouchArea { clicked => { AppState.lang = "en"; }
                Rectangle { height: 28px; border-radius: 14px; background: AppState.lang == "en" ? Theme.purple : #ffffff08; border-width: 1px; border-color: AppState.lang == "en" ? Theme.purple : Theme.border;
                    Text { text: "EN"; font-size: 11px; font-weight: 700; color: AppState.lang == "en" ? white : Theme.muted; horizontal-alignment: center; vertical-alignment: center; } }
            }
            TouchArea { clicked => { AppState.lang = "ru"; }
                Rectangle { height: 28px; border-radius: 14px; background: AppState.lang == "ru" ? Theme.purple : #ffffff08; border-width: 1px; border-color: AppState.lang == "ru" ? Theme.purple : Theme.border;
                    Text { text: "RU"; font-size: 11px; font-weight: 700; color: AppState.lang == "ru" ? white : Theme.muted; horizontal-alignment: center; vertical-alignment: center; } }
            }
        }
    }
}

component ToolButton inherits TouchArea {
    in property <string> label;
    in property <string> icon;
    in property <bool> active;
    in property <string> kind;
    clicked => { AppState.studio-tool = kind; }
    Rectangle {
        border-radius: 12px;
        background: active ? Theme.purple : #ffffff06;
        border-width: 1px; border-color: active ? Theme.purple : Theme.border;
        drop-shadow-blur: active ? 16px : 0px; drop-shadow-color: Theme.purple-glow;
        VerticalBox {
            padding: 6px;
            spacing: 2px;
            Text { text: icon; font-size: 16px; color: active ? white : Theme.muted; horizontal-alignment: center; }
            Text { text: label; font-size: 8px; font-weight: 700; color: active ? white : Theme.muted; horizontal-alignment: center; letter-spacing: 0.6px; }
        }
        animate background { duration: 180ms; easing: ease-in-out; }
    }
}

component StudioLayout inherits Rectangle {
    background: transparent;
    HorizontalBox {
        padding: 0;
        spacing: 0;
        // TOOL RAIL
        Rectangle {
            width: 68px;
            background: #12131AF2;
            border-width: 1px; border-color: Theme.border;
            VerticalBox {
                padding: 12px;
                spacing: 8px;
                Text { text: "TOOLS"; font-size: 8px; font-weight: 700; color: Theme.muted; letter-spacing: 1.2px; horizontal-alignment: center; }
                ToolButton { label: "Select"; icon: "⌖"; kind: "select"; active: AppState.studio-tool == "select"; height: 52px; }
                ToolButton { label: "Wall"; icon: "—"; kind: "wall"; active: AppState.studio-tool == "wall"; height: 52px; }
                ToolButton { label: "Room"; icon: "▭"; kind: "room"; active: AppState.studio-tool == "room"; height: 52px; }
                ToolButton { label: "Column"; icon: "⬢"; kind: "column"; active: AppState.studio-tool == "column"; height: 52px; }
                ToolButton { label: "Beam"; icon: "━"; kind: "beam"; active: AppState.studio-tool == "beam"; height: 52px; }
                Rectangle { height: 1px; background: Theme.border; }
                TouchArea { clicked => { if (AppState.studio-selected != "") { AppState.request-duplicate(AppState.studio-selected); } }
                    Rectangle { height: 36px; border-radius: 10px; background: #ffffff06; border-width: 1px; border-color: Theme.border;
                        Text { text: "⧉ Dup"; font-size: 10px; font-weight: 600; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; } }
                }
                TouchArea { clicked => { if (AppState.studio-selected != "") { AppState.request-delete(AppState.studio-selected); } }
                    Rectangle { height: 36px; border-radius: 10px; background: #FF5F5612; border-width: 1px; border-color: #FF5F5630;
                        Text { text: "✕ Del"; font-size: 10px; font-weight: 600; color: #FF8A8A; horizontal-alignment: center; vertical-alignment: center; } }
                }
                Rectangle { }
                TouchArea { clicked => { AppState.request-save(); }
                    Rectangle { height: 36px; border-radius: 10px; background: Theme.purple; Text { text: "💾 Save"; font-size: 10px; font-weight: 700; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                }
            }
        }
        // CANVAS
        Rectangle {
            background: Theme.bg;
            VerticalBox {
                padding: 12px;
                spacing: 8px;
                // top bar
                HorizontalBox {
                    height: 32px;
                    spacing: 8px;
                    Text { text: AppState.project-name; font-size: 13px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                    Text { text: "— " + AppState.elements.length + " elements • " + AppState.studio-tool + " • click canvas to place"; font-size: 11px; color: Theme.muted; vertical-alignment: center; }
                    Rectangle { }
                    TouchArea { clicked => { AppState.request-new-project(); }
                        Rectangle { width: 90px; border-radius: 999px; background: #ffffff08; border-width: 1px; border-color: Theme.border;
                            Text { text: "+ New"; font-size: 11px; font-weight: 600; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; } }
                    }
                }
                // canvas area with grid
                Rectangle {
                    background: #0E0E14;
                    border-width: 1px; border-color: Theme.border; border-radius: 16px;
                    clip: true;
                    // grid lines — simple overlay
                    // actual canvas
                    Rectangle {
                        x: 0; y: 0; width: parent.width; height: parent.height;
                        TouchArea {
                            clicked => { AppState.request-canvas-click(self.mouse-x, self.mouse-y); }
                            // elements
                            for el in AppState.elements : Rectangle {
                                x: el.x;
                                y: el.y;
                                width: el.w;
                                height: el.h;
                                background: el.material == "concrete" ? #A8A29E : el.material == "brick" ? #B45309 : el.material == "glass" ? #7DD3FC80 : el.material == "timber" ? #B48A46 : #94A3B8;
                                border-width: el.selected ? 2px : 1px;
                                border-color: el.selected ? Theme.purple : #ffffff14;
                                border-radius: el.kind == "column" ? 8px : 4px;
                                drop-shadow-blur: el.selected ? 14px : 0px; drop-shadow-color: Theme.purple-glow;
                                // selection glow
                                Rectangle {
                                    width: 100%; height: 100%; border-radius: parent.border-radius;
                                    background: el.selected ? #7C5CFC14 : transparent;
                                    animate background { duration: 180ms; }
                                }
                                Text {
                                    text: el.kind == "room" ? "ROOM" : el.kind == "wall" ? "WALL" : el.kind == "column" ? "⬢" : "BEAM";
                                    font-size: el.kind == "room" ? 10px : 8px; font-weight: 700;
                                    color: #ffffffB0; horizontal-alignment: center; vertical-alignment: center;
                                }
                                // resize handle (bottom-right)
                                if (el.selected): Rectangle {
                                    x: parent.width - 10px; y: parent.height - 10px; width: 10px; height: 10px;
                                    background: Theme.purple; border-radius: 3px; border-width: 1px; border-color: white;
                                    TouchArea {
                                        property <length> start-x;
                                        property <length> start-y;
                                        property <length> start-w;
                                        property <length> start-h;
                                        pointer-event => {
                                            if (self.pressed) {
                                                start-x = self.mouse-x;
                                                start-y = self.mouse-y;
                                                start-w = el.w;
                                                start-h = el.h;
                                            }
                                        }
                                        moved => {
                                            if (self.pressed) {
                                                AppState.request-resize(el.id, start-w + (self.mouse-x - start-x), start-h + (self.mouse-y - start-y));
                                            }
                                        }
                                    }
                                }
                                TouchArea {
                                    property <length> drag-off-x;
                                    property <length> drag-off-y;
                                    clicked => { AppState.request-select(el.id); }
                                    pointer-event => {
                                        if (self.pressed) {
                                            drag-off-x = self.mouse-x;
                                            drag-off-y = self.mouse-y;
                                            AppState.request-select(el.id);
                                        }
                                    }
                                    moved => {
                                        if (self.pressed) {
                                            AppState.request-move(el.id, self.mouse-x - drag-off-x, self.mouse-y - drag-off-y);
                                            drag-off-x = self.mouse-x;
                                            drag-off-y = self.mouse-y;
                                        }
                                    }
                                }
                                animate x { duration: 0ms; }
                                animate y { duration: 0ms; }
                            }
                            // grid dots — visual only
                            Rectangle {
                                width: 100%; height: 100%;
                                // semi-transparent grid overlay via repeating? simplistic: border pattern
                                // we keep minimal to avoid perf hit
                            }
                        }
                    }
                    // ruler hints
                    Text { x: 8px; y: 8px; text: "Canvas 900×600 — grid 8px snap — drag to move, handle to resize"; font-size: 9px; color: #ffffff40; }
                }
            }
        }
        // INSPECTOR
        Rectangle {
            width: 300px;
            background: #12131A;
            border-width: 1px; border-color: Theme.border;
            VerticalBox {
                padding: 16px;
                spacing: 12px;
                Text { text: "INSPECTOR"; font-size: 10px; font-weight: 700; color: Theme.muted; letter-spacing: 1.4px; }
                if (AppState.studio-selected == ""): VerticalBox {
                    spacing: 10px;
                    Rectangle { height: 80px; border-radius: 12px; background: #ffffff04; border-width: 1px; border-color: Theme.border;
                        VerticalBox {
                            padding: 12px;
                            Text { text: "No selection"; font-size: 12px; font-weight: 600; color: Theme.muted; }
                            Text { text: "Select an element on canvas or place a new one with tools."; font-size: 11px; color: Theme.muted2; wrap: word-wrap; }
                        }
                    }
                    Text { text: "Project: " + AppState.project-name; font-size: 11px; color: Theme.muted; }
                    Text { text: "Tip: Room = concrete slab with subtle border, Wall/Beam = linear, Column = square."; font-size: 10px; color: Theme.muted2; wrap: word-wrap; }
                }
                if (AppState.studio-selected != ""): VerticalBox {
                    spacing: 10px;
                    // find selected element — we pass via root properties mirrored by Rust
                    // Rust updates inspector fields as separate properties for simplicity
                    // Here we expose generic inspector bound to AppState.selected details via extra properties set from Rust
                    Text { text: "Selection: " + AppState.studio-selected; font-size: 11px; color: Theme.purple2; }
                    HorizontalBox {
                        spacing: 8px;
                        // position / size are shown via callbacks, for MVP we provide buttons to nudge
                        VerticalBox {
                            spacing: 4px;
                            Text { text: "Position & Size"; font-size: 10px; font-weight: 700; color: Theme.muted; }
                            HorizontalBox {
                                spacing: 6px;
                                TouchArea { clicked => { AppState.request-move(AppState.studio-selected, -8px, 0px); } Rectangle { width: 28px; height: 28px; border-radius: 8px; background: #ffffff08; border-width: 1px; border-color: Theme.border; Text { text: "←"; font-size: 12px; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; } } }
                                TouchArea { clicked => { AppState.request-move(AppState.studio-selected, 8px, 0px); } Rectangle { width: 28px; height: 28px; border-radius: 8px; background: #ffffff08; border-width: 1px; border-color: Theme.border; Text { text: "→"; font-size: 12px; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; } } }
                                TouchArea { clicked => { AppState.request-move(AppState.studio-selected, 0px, -8px); } Rectangle { width: 28px; height: 28px; border-radius: 8px; background: #ffffff08; border-width: 1px; border-color: Theme.border; Text { text: "↑"; font-size: 12px; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; } } }
                                TouchArea { clicked => { AppState.request-move(AppState.studio-selected, 0px, 8px); } Rectangle { width: 28px; height: 28px; border-radius: 8px; background: #ffffff08; border-width: 1px; border-color: Theme.border; Text { text: "↓"; font-size: 12px; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; } } }
                            }
                            HorizontalBox {
                                spacing: 6px;
                                TouchArea { clicked => { AppState.request-resize(AppState.studio-selected, -12px, 0px); } Rectangle { height: 28px; border-radius: 8px; background: #ffffff08; border-width: 1px; border-color: Theme.border; Text { text: "−W"; font-size: 10px; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; } } }
                                TouchArea { clicked => { AppState.request-resize(AppState.studio-selected, 12px, 0px); } Rectangle { height: 28px; border-radius: 8px; background: #ffffff08; border-width: 1px; border-color: Theme.border; Text { text: "+W"; font-size: 10px; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; } } }
                                TouchArea { clicked => { AppState.request-resize(AppState.studio-selected, 0px, -12px); } Rectangle { height: 28px; border-radius: 8px; background: #ffffff08; border-width: 1px; border-color: Theme.border; Text { text: "−H"; font-size: 10px; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; } } }
                                TouchArea { clicked => { AppState.request-resize(AppState.studio-selected, 0px, 12px); } Rectangle { height: 28px; border-radius: 8px; background: #ffffff08; border-width: 1px; border-color: Theme.border; Text { text: "+H"; font-size: 10px; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; } } }
                            }
                        }
                    }
                    Text { text: "Material"; font-size: 10px; font-weight: 700; color: Theme.muted; }
                    HorizontalBox {
                        spacing: 6px;
                        TouchArea { clicked => { AppState.request-material(AppState.studio-selected, "concrete"); } Rectangle { height: 32px; border-radius: 8px; background: #A8A29E; Text { text: "Concrete"; font-size: 9px; font-weight: 700; color: #1A1A1A; horizontal-alignment: center; vertical-alignment: center; } } }
                        TouchArea { clicked => { AppState.request-material(AppState.studio-selected, "brick"); } Rectangle { height: 32px; border-radius: 8px; background: #B45309; Text { text: "Brick"; font-size: 9px; font-weight: 700; color: white; horizontal-alignment: center; vertical-alignment: center; } } }
                        TouchArea { clicked => { AppState.request-material(AppState.studio-selected, "glass"); } Rectangle { height: 32px; border-radius: 8px; background: #7DD3FC; Text { text: "Glass"; font-size: 9px; font-weight: 700; color: #0C4A6E; horizontal-alignment: center; vertical-alignment: center; } } }
                    }
                    HorizontalBox {
                        spacing: 6px;
                        TouchArea { clicked => { AppState.request-material(AppState.studio-selected, "timber"); } Rectangle { height: 32px; border-radius: 8px; background: #B48A46; Text { text: "Timber"; font-size: 9px; font-weight: 700; color: #1A1A1A; horizontal-alignment: center; vertical-alignment: center; } } }
                        TouchArea { clicked => { AppState.request-material(AppState.studio-selected, "steel"); } Rectangle { height: 32px; border-radius: 8px; background: #94A3B8; Text { text: "Steel"; font-size: 9px; font-weight: 700; color: #0F172A; horizontal-alignment: center; vertical-alignment: center; } } }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        TouchArea { clicked => { AppState.request-duplicate(AppState.studio-selected); } Rectangle { height: 36px; border-radius: 10px; background: #ffffff08; border-width: 1px; border-color: Theme.border; Text { text: "⧉ Duplicate"; font-size: 11px; font-weight: 600; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; } } }
                        TouchArea { clicked => { AppState.request-delete(AppState.studio-selected); } Rectangle { height: 36px; border-radius: 10px; background: #FF5F5614; border-width: 1px; border-color: #FF5F5640; Text { text: "✕ Delete"; font-size: 11px; font-weight: 600; color: #FF8A8A; horizontal-alignment: center; vertical-alignment: center; } } }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                Text { text: "Learn → Create: study structures, then place walls/beams in Studio. Materials affect visual, future structural hints."; font-size: 10px; color: Theme.muted2; wrap: word-wrap; }
            }
        }
    }
}

component HomePage inherits Rectangle {
    background: transparent;
    VerticalBox {
        padding: 24px;
        spacing: 16px;
        HorizontalBox {
            spacing: 16px;
            VerticalBox {
                spacing: 8px;
                Text { text: "LEARN HOW BUILDINGS STAND."; font-size: 28px; font-weight: 700; color: Theme.text; }
                Text { text: "A premium desktop experience for architecture fundamentals — now with a real creation workspace."; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                HorizontalBox {
                    spacing: 10px;
                    TouchArea { clicked => { AppState.view = "study"; } Rectangle { height: 36px; width: 140px; border-radius: 999px; background: Theme.purple; Text { text: "Enter Study →"; font-size: 11px; font-weight: 700; color: white; horizontal-alignment: center; vertical-alignment: center; } } }
                    TouchArea { clicked => { AppState.view = "studio"; } Rectangle { height: 36px; width: 140px; border-radius: 999px; background: #ffffff08; border-width: 1px; border-color: Theme.border; Text { text: "Open Studio →"; font-size: 11px; font-weight: 600; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; } } }
                }
            }
            Rectangle {
                background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: 16px;
                VerticalBox {
                    padding: 16px;
                    Text { text: "AXIOM OS • PREMIUM — Slint Native"; font-size: 9px; color: Theme.muted; }
                    Text { text: "Constructive intelligence."; font-size: 16px; font-weight: 700; color: Theme.text; }
                    Text { text: "No browser. Single binary. GPU-accelerated canvas."; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
                }
            }
        }
        HorizontalBox {
            spacing: 14px;
            Rectangle { background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: 16px;
                VerticalBox { padding: 16px; spacing: 6px; Text { text: "Study Mode"; font-size: 13px; font-weight: 700; color: Theme.text; } Text { text: "8 courses • quizzes • progress"; font-size: 11px; color: Theme.muted; } Rectangle { height: 6px; border-radius: 3px; background: #ffffff12; Rectangle { width: 34%; height: 100%; background: Theme.purple; border-radius: 3px; } } } }
            Rectangle { background: Theme.surface; border-width: 1px; border-color: Theme.purple; border-radius: 16px;
                VerticalBox { padding: 16px; spacing: 6px; Text { text: "AXIOM Studio — NEW"; font-size: 13px; font-weight: 700; color: Theme.purple2; } Text { text: "Build walls, rooms, beams. Drag, resize, assign materials."; font-size: 11px; color: Theme.muted; } Text { text: "Studio →"; font-size: 11px; font-weight: 700; color: Theme.purple2; } } }
        }
    }
}

component StudyPage inherits Rectangle {
    background: transparent;
    VerticalBox {
        padding: 24px;
        spacing: 12px;
        Text { text: "Study Mode — structured learning"; font-size: 11px; color: Theme.purple2; }
        Text { text: "From first principles to real buildings."; font-size: 18px; font-weight: 700; color: Theme.text; }
        Text { text: "Courses preserved from legacy — rendered natively. Lessons open here (MVP shows list, full markdown next iteration)."; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
        // simple placeholder list
        VerticalBox {
            spacing: 8px;
            Rectangle { height: 64px; background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: 14px;
                HorizontalBox { padding: 12px; spacing: 10px; Rectangle { width: 36px; height: 36px; border-radius: 10px; background: Theme.purple; Text { text: "◐"; font-size: 14px; color: white; horizontal-alignment: center; vertical-alignment: center; } } VerticalBox { Text { text: "Fundamentals of Architecture"; font-size: 12px; font-weight: 600; color: Theme.text; } Text { text: "Beginner • 4 lessons"; font-size: 10px; color: Theme.muted; } } } }
            Rectangle { height: 64px; background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: 14px;
                HorizontalBox { padding: 12px; spacing: 10px; Rectangle { width: 36px; height: 36px; border-radius: 10px; background: Theme.purple; Text { text: "⬢"; font-size: 14px; color: white; horizontal-alignment: center; vertical-alignment: center; } } VerticalBox { Text { text: "Structures that Stand"; font-size: 12px; font-weight: 600; color: Theme.text; } Text { text: "Beginner • 4 lessons"; font-size: 10px; color: Theme.muted; } } } }
            Rectangle { height: 64px; background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: 14px;
                HorizontalBox { padding: 12px; spacing: 10px; Rectangle { width: 36px; height: 36px; border-radius: 10px; background: Theme.purple; Text { text: "▭"; font-size: 14px; color: white; horizontal-alignment: center; vertical-alignment: center; } } VerticalBox { Text { text: "Materials & Tectonics"; font-size: 12px; font-weight: 600; color: Theme.text; } Text { text: "Intermediate • 3 lessons"; font-size: 10px; color: Theme.muted; } } } }
        }
    }
}

component ExplorePage inherits Rectangle {
    background: transparent;
    VerticalBox {
        padding: 24px;
        spacing: 10px;
        Text { text: "Explore — free browsing of topics"; font-size: 18px; font-weight: 700; color: Theme.text; }
        Text { text: "Legacy topics (Gothic, Brutalism, Trusses, Concrete...) — native list, detail view coming next."; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
        for t in [{title:"Gothic — Light as Structure"}, {title:"Brutalism — Truth of Material"}, {title:"Trusses — Triangles that Span"}, {title:"Concrete — Liquid Stone"}] : Rectangle {
            height: 44px; background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: 12px;
            HorizontalBox { padding: 10px; Text { text: t.title; font-size: 11px; color: Theme.text; vertical-alignment: center; } }
        }
    }
}

export component App inherits Window {
    title: "AXIOM";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 1120px;
    min-height: 700px;
    background: Theme.bg;
    // no-frame handled in Rust via WindowAttributes if needed; Slint default is decorated — we keep decorated for now, custom titlebar is visual
    VerticalBox {
        padding: 0;
        spacing: 0;
        Titlebar {}
        HorizontalBox {
            padding: 0;
            spacing: 0;
            Sidebar {}
            Rectangle {
                background: transparent;
                if (AppState.view == "home"): HomePage {}
                if (AppState.view == "study"): StudyPage {}
                if (AppState.view == "explore"): ExplorePage {}
                if (AppState.view == "studio"): StudioLayout {}
            }
        }
    }
}
