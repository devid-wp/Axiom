// AXIOM v2 — application root. Persistent IDE shell + view routing.
// Shell (activity bar / title bar / status bar) is always present;
// screens own only their workspace. No styling decisions live here.

import { HorizontalBox, VerticalBox } from "std-widgets.slint";
import { Theme } from "theme/colors.slint";
import { AppState } from "state.slint";
import { ActivityBar, TitleBar, StatusBar } from "screens/shell.slint";
import { StartScreen } from "screens/home.slint";
import { StudioScreen } from "screens/studio.slint";
import { StudyScreen } from "screens/study.slint";
import { ExploreScreen } from "screens/explore.slint";

export { AppState } from "state.slint";

export component App inherits Window {
    title: "AXIOM";
    preferred-width: 1360px;
    preferred-height: 860px;
    min-width: 1120px;
    min-height: 700px;
    background: Theme.bg;

    HorizontalBox {
        padding: 0; spacing: 0;
        ActivityBar {}
        VerticalBox {
            padding: 0; spacing: 0;
            TitleBar {}
            Rectangle {
                background: transparent;
                clip: true;
                if (AppState.view == "home"): StartScreen {}
                if (AppState.view == "studio"): StudioScreen {}
                if (AppState.view == "study"): StudyScreen {}
                if (AppState.view == "explore"): ExploreScreen {}
            }
            StatusBar {}
        }
    }
}
